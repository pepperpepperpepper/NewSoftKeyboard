<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Nsk.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keyboard Packs" />

        <TextView
            android:id="@+id/installed_packs_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Installed packs: (loading…)" />

        <TextView
            android:id="@+id/active_pack_keyboard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Active pack keyboard: (none)" />

        <wtf.uhoh.newsoftkeyboard.app.keyboards.views.DemoKeyboardView
            android:id="@+id/pack_keyboard_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/import_pack_zip_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Import pack zip" />

            <Button
                android:id="@+id/select_active_pack_keyboard_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Set active keyboard" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clear_active_pack_keyboard_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear override" />

            <Button
                android:id="@+id/export_active_pack_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Export active pack" />
        </LinearLayout>

        <TextView
            android:id="@+id/last_action_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="" />
    </LinearLayout>
</ScrollView>
