<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <EditText
        android:id="@+id/char_picker_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/custom_keyboards_char_picker_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <Spinner
        android:id="@+id/char_picker_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <GridView
        android:id="@+id/char_picker_grid"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp"
        android:numColumns="6"
        android:stretchMode="columnWidth" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/char_picker_codepoint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/custom_keyboards_char_picker_codepoint_hint"
            android:inputType="text" />

        <Button
            android:id="@+id/char_picker_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/custom_keyboards_char_picker_use" />
    </LinearLayout>
</LinearLayout>
