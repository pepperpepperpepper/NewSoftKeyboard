<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/custom_keyboard_editor_instructions"
            style="@style/Nsk.Text.SubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:text="@string/custom_keyboards_edit_instructions" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/custom_keyboard_editor_test_typing_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:text="@string/custom_keyboards_test_typing_switch" />

        <LinearLayout
            android:id="@+id/custom_keyboard_editor_test_typing_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/custom_keyboard_editor_test_typing_buffer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/editTextBackground"
                android:ellipsize="end"
                android:hint="@string/custom_keyboards_test_typing_hint"
                android:minHeight="48dp"
                android:padding="8dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorHint"
                android:textIsSelectable="true" />

            <Button
                android:id="@+id/custom_keyboard_editor_test_typing_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/custom_keyboards_test_typing_clear" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/custom_keyboard_editor_theme_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_keyboards_theme_button" />

            <Button
                android:id="@+id/custom_keyboard_editor_undo_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:enabled="false"
                android:text="@string/custom_keyboards_undo_button" />
        </LinearLayout>

        <wtf.uhoh.newsoftkeyboard.app.keyboards.views.DesignerKeyboardView
            android:id="@+id/custom_keyboard_editor_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:id="@+id/custom_keyboard_editor_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/custom_keyboard_editor_selection_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/custom_keyboard_editor_selection_row_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/dividerVertical"
                    android:dividerPadding="8dp"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_edit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_selection_edit"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_edit"
                        android:tooltipText="@string/custom_keyboards_selection_edit"
                        app:tint="?android:attr/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_move_left"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_layout_action_move_key_left"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_move_left"
                        android:tooltipText="@string/custom_keyboards_layout_action_move_key_left"
                        app:tint="?android:attr/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_move_right"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_layout_action_move_key_right"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_move_right"
                        android:tooltipText="@string/custom_keyboards_layout_action_move_key_right"
                        app:tint="?android:attr/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_insert"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_selection_insert"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_insert"
                        android:tooltipText="@string/custom_keyboards_selection_insert"
                        app:tint="?android:attr/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_delete"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_selection_delete"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_delete"
                        android:tooltipText="@string/custom_keyboards_selection_delete"
                        app:tint="?android:attr/textColorPrimary" />

                    <ImageButton
                        android:id="@+id/custom_keyboard_editor_selection_row_actions"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/custom_keyboards_selection_row_actions"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_designer_rows"
                        android:tooltipText="@string/custom_keyboards_selection_row_actions"
                        app:tint="?android:attr/textColorPrimary" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/custom_keyboard_editor_validation_warnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:textColor="@android:color/holo_orange_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/custom_keyboard_editor_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:text="" />
    </LinearLayout>
</ScrollView>
