<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/global_content_padding_side"
    android:paddingEnd="@dimen/global_content_padding_side"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/keyboard_demo_shadow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/keyboard_theme_wallpaper_customization_preview_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wallpaper_live_preview_overlays_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Caption"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/wallpaper_live_preview_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/wallpaper_live_preview_focus_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="@string/keyboard_theme_live_preview_focus_label"
                    android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                <HorizontalScrollView
                    android:id="@+id/wallpaper_live_preview_focus_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_auto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_auto"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_background"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_background"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_keys"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_keys"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_text"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_suggestions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_suggestions"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

                        <TextView
                            android:id="@+id/wallpaper_live_preview_focus_overlays"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/preview_focus_chip_background"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/keyboard_theme_live_preview_focus_overlays"
                            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/wallpaper_live_preview_toggle_suggestions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/keyboard_theme_live_preview_toggle_suggestions" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/wallpaper_live_preview_toggle_shift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/keyboard_theme_live_preview_toggle_shift" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/wallpaper_live_preview_toggle_typing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_toggle_typing" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/wallpaper_live_preview_toggle_original"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_toggle_original" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/wallpaper_live_preview_toggle_inspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_toggle_inspect" />

                <Button
                    android:id="@+id/wallpaper_live_preview_layout_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_layout_button"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/wallpaper_live_preview_overlays_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_overlays_button"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/wallpaper_live_preview_open_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keyboard_theme_live_preview_open_keyboard"
                    android:textAllCaps="false" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/wallpaper_live_preview_keyboard_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/wallpaper_live_preview_candidates_container"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/candidate_strip_height">

                        <wtf.uhoh.newsoftkeyboard.app.keyboards.views.CandidateView
                            android:id="@+id/wallpaper_live_preview_candidates"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="0px"
                            android:padding="0px" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/wallpaper_live_preview_keyboard_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <wtf.uhoh.newsoftkeyboard.app.keyboards.views.DemoKeyboardView
                            android:id="@+id/wallpaper_live_preview_keyboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
