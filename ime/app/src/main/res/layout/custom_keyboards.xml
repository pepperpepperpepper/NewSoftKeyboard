<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/Nsk.Text.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/custom_keyboards_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/create_custom_keyboard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custom_keyboards_new_keyboard_button" />

        <Button
            android:id="@+id/import_custom_keyboard_pack_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/custom_keyboards_import_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/custom_keyboards_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/custom_keyboards_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
