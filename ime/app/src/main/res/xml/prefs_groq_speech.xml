<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/groq_speech_settings_title">

    <Preference
        android:key="groq_speech_privacy_notice"
        android:title="@string/speech_to_text_privacy_notice_title"
        android:summary="@string/groq_speech_privacy_notice_summary"
        android:selectable="false"
        app:iconSpaceReserved="false" />

    <androidx.preference.PreferenceCategory
        android:title="@string/groq_api_settings_group">

        <wtf.uhoh.newsoftkeyboard.app.ui.settings.SpeechToTextApiKeyPreference
            android:key="@string/settings_key_groq_api_key"
            android:title="@string/groq_api_key_title"
            android:summary="@string/groq_api_key_summary"
            android:dialogTitle="@string/groq_api_key_dialog_title"
            android:inputType="textPassword"
            android:persistent="false" />

        <androidx.preference.EditTextPreference
            android:key="@string/settings_key_groq_endpoint"
            android:title="@string/groq_endpoint_title"
            android:summary="@string/groq_endpoint_summary"
            android:dialogTitle="@string/groq_endpoint_dialog_title"
            android:defaultValue="https://api.groq.com/openai/v1/audio/transcriptions"
            android:persistent="true" />

        <androidx.preference.EditTextPreference
            android:key="@string/settings_key_groq_model"
            android:title="@string/groq_model_title"
            android:summary="@string/groq_model_summary"
            android:dialogTitle="@string/groq_model_dialog_title"
            android:defaultValue="whisper-large-v3-turbo"
            android:persistent="true" />

        <androidx.preference.EditTextPreference
            android:key="@string/settings_key_groq_language"
            android:title="@string/groq_language_title"
            android:summary="@string/groq_language_summary"
            android:dialogTitle="@string/groq_language_dialog_title"
            android:persistent="true" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:title="@string/groq_behavior_settings_group">

        <androidx.preference.SwitchPreferenceCompat
            android:key="@string/settings_key_groq_add_trailing_space"
            android:title="@string/groq_add_trailing_space_title"
            android:summary="@string/groq_add_trailing_space_summary"
            android:defaultValue="true"
            android:persistent="true" />
    </androidx.preference.PreferenceCategory>

</androidx.preference.PreferenceScreen>
